@PACKAGE_INIT@
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(NimbyRailsFranceSDK_FOUND FALSE)
    set(NimbyRailsFranceSDK_NOT_FOUND_MESSAGE "NimbyRailsFranceSDK requires Windows x64")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NimbyRailsFranceSDKTargets.cmake")
# Runtime files from this installed package, relative to its current location.
file(GLOB NimbyRailsFranceSDK_RUNTIME_FILES "${PACKAGE_PREFIX_DIR}/bin/*.dll")
check_required_components(NimbyRailsFranceSDK)
