@PACKAGE_INIT@
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(NimbyRailsFranceSDK_FOUND FALSE)
    set(NimbyRailsFranceSDK_NOT_FOUND_MESSAGE "NimbyRailsFranceSDK requires Windows x64")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NimbyRailsFranceSDKTargets.cmake")
if(NOT TARGET NimbyRailsFranceSDK::Mod)
    add_library(NimbyRailsFranceSDK::Mod INTERFACE IMPORTED)
    set_target_properties(NimbyRailsFranceSDK::Mod PROPERTIES
        INTERFACE_SOURCES "${PACKAGE_PREFIX_DIR}/share/NimbyRailsFranceSDK/mod/entry.cpp"
        INTERFACE_LINK_LIBRARIES NimbyRailsFranceSDK::SDK
        INTERFACE_COMPILE_FEATURES cxx_std_20
        INTERFACE_COMPILE_DEFINITIONS "NOMINMAX;WIN32_LEAN_AND_MEAN")
endif()
# Runtime files from this installed package, relative to its current location.
file(GLOB NimbyRailsFranceSDK_RUNTIME_FILES CONFIGURE_DEPENDS "${PACKAGE_PREFIX_DIR}/bin/*.dll")
check_required_components(NimbyRailsFranceSDK)
