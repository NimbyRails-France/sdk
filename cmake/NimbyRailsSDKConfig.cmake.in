@PACKAGE_INIT@
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(NimbyRailsSDK_FOUND FALSE)
    set(NimbyRailsSDK_NOT_FOUND_MESSAGE "NimbyRailsSDK requires Windows x64")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NimbyRailsSDKTargets.cmake")
# Runtime files from this installed package, relative to its current location.
file(GLOB NimbyRailsSDK_RUNTIME_FILES "${PACKAGE_PREFIX_DIR}/bin/*.dll")
check_required_components(NimbyRailsSDK)
